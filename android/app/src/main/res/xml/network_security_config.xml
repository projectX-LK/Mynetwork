<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is only permitted to the device's own loopback address,
         used by the local relay so native players can consume the
         (already-decrypted-and-verified) media stream. All traffic to
         other devices on the network still uses HTTPS with certificate
         pinning; this config does not weaken that. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
